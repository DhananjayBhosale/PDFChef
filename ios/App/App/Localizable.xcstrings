    "Trust could not be established at the current time; the issuer may be untrusted, a certificate may have expired, or the chain may be incomplete." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر إثبات الثقة في الوقت الحالي؛ قد تكون الجهة المُصدرة غير موثوقة، أو قد تكون إحدى الشهادات منتهية الصلاحية، أو قد تكون السلسلة غير مكتملة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillid kunne ikke etableres på nuværende tidspunkt. Udstederen er muligvis ikke betroet, et certifikat kan være udløbet, eller kæden kan være ufuldstændig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrauen konnte derzeit nicht hergestellt werden. Der Aussteller ist möglicherweise nicht vertrauenswürdig, ein Zertifikat ist abgelaufen oder die Kette ist unvollständig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trust could not be established at the current time; the issuer may be untrusted, a certificate may have expired, or the chain may be incomplete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido establecer la confianza en este momento: es posible que el emisor no sea de confianza, que un certificado haya caducado o que la cadena esté incompleta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo establecer la confianza en este momento: es posible que el emisor no sea de confianza, que un certificado haya vencido o que la cadena esté incompleta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La confiance n’a pas pu être établie pour le moment : l’émetteur n’est peut-être pas fiable, un certificat a peut-être expiré ou la chaîne est peut-être incomplète."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La confiance n’a pas pu être établie pour le moment : l’émetteur n’est peut-être pas fiable, un certificat a peut-être expiré ou la chaîne est peut-être incomplète."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस समय भरोसा स्थापित नहीं हो सका; जारीकर्ता भरोसेमंद नहीं हो सकता, कोई प्रमाणपत्र समाप्त हो सकता है, या चेन अधूरी हो सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kepercayaan tidak dapat dibangun saat ini; penerbit mungkin tidak tepercaya, sertifikat mungkin telah kedaluwarsa, atau rantainya mungkin tidak lengkap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non è stato possibile stabilire l’affidabilità: l’emittente potrebbe non essere attendibile, un certificato potrebbe essere scaduto o la catena potrebbe essere incompleta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現時点では信頼を確立できませんでした。発行元が信頼されていない、証明書の期限が切れている、またはチェーンが不完全な可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 신뢰를 확인할 수 없습니다. 발급자를 신뢰할 수 없거나, 인증서가 만료되었거나, 체인이 불완전할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrouwen kon op dit moment niet worden vastgesteld. De uitgever is mogelijk niet vertrouwd, een certificaat is mogelijk verlopen of de keten is onvolledig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się teraz ustalić zaufania. Wystawca może być niezaufany, certyfikat mógł wygasnąć albo łańcuch może być niekompletny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível estabelecer a confiança neste momento. O emissor pode não ser confiável, um certificado pode ter expirado ou a cadeia pode estar incompleta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível estabelecer a confiança neste momento. O emissor pode não ser fidedigno, um certificado pode ter expirado ou a cadeia pode estar incompleta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förtroende kunde inte fastställas just nu. Utfärdaren kanske inte är betrodd, ett certifikat kan ha gått ut eller kedjan kan vara ofullständig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda güven sağlanamadı. Düzenleyen güvenilir olmayabilir, bir sertifikanın süresi dolmuş olabilir ya da zincir eksik olabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法建立信任：颁发者可能不受信任、某个证书可能已过期，或证书链可能不完整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法建立信任：簽發者可能不受信任、某個憑證可能已過期，或憑證鏈可能不完整。"
          }
        }
      }
    },
