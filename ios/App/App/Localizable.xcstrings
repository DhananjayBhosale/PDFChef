    "You’ve used this week’s free jobs. Unlock PDF Chef Pro to split large PDFs into smaller parts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد استخدمت المهام المجانية لهذا الأسبوع. قم بالترقية إلى PDF Chef Pro لتقسيم ملفات PDF الكبيرة إلى أجزاء أصغر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brugt denne uges gratis opgaver. Lås PDF Chef Pro op for at opdele store PDF-filer i mindre dele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die kostenlosen Aufträge dieser Woche aufgebraucht. Schalte PDF Chef Pro frei, um große PDFs in kleinere Teile aufzuteilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ve used this week’s free jobs. Unlock PDF Chef Pro to split large PDFs into smaller parts."
