    "Shares a separate copy with the verified check mark, protected with the same password. The original file is not changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشارك نسخة منفصلة تحمل علامة التحقق ومحمية بكلمة المرور نفسها. لا يتغير الملف الأصلي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deler en separat kopi med verificeringsmærket, beskyttet med samme adgangskode. Den originale fil ændres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt eine separate Kopie mit dem Prüfhäkchen, geschützt mit demselben Passwort. Die Originaldatei bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shares a separate copy with the verified check mark, protected with the same password. The original file is not changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte una copia aparte con la marca de verificación, protegida con la misma contraseña. El archivo original no cambia."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte una copia aparte con la marca de verificación, protegida con la misma contraseña. El archivo original no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage une copie distincte avec la coche de vérification, protégée par le même mot de passe. Le fichier original n’est pas modifié."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage une copie distincte avec le crochet de vérification, protégée par le même mot de passe. Le fichier original n’est pas modifié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सत्यापित चिह्न वाली एक अलग कॉपी साझा करता है, जो उसी पासवर्ड से सुरक्षित होती है। मूल फ़ाइल नहीं बदलती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membagikan salinan terpisah dengan tanda centang terverifikasi, dilindungi kata sandi yang sama. File asli tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condivide una copia separata con il segno di verifica, protetta con la stessa password. Il file originale non viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検証済みのチェックマーク付きの別コピーを、同じパスワードで保護して共有します。元のファイルは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인 표시가 있는 별도 사본을 같은 비밀번호로 보호해 공유합니다. 원본 파일은 바뀌지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deelt een aparte kopie met het controlevinkje, beveiligd met hetzelfde wachtwoord. Het originele bestand blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnia osobną kopię ze znakiem weryfikacji, chronioną tym samym hasłem. Oryginalny plik się nie zmienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilha uma cópia separada com a marca de verificação, protegida com a mesma senha. O arquivo original não é alterado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilha uma cópia separada com a marca de verificação, protegida com a mesma palavra-passe. O ficheiro original não é alterado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delar en separat kopia med verifieringsbocken, skyddad med samma lösenord. Originalfilen ändras inte."
