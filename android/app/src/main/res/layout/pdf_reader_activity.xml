<?xml version="1.0" encoding="utf-8"?>
<!-- The reader surface: one compact bar, the document, and nothing else. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdf_reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pdf_reader_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/pdf_reader_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pdf_reader_chrome"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/pdf_reader_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pdf_reader_back"
                android:scaleType="centerInside"
                android:src="@drawable/pdf_reader_ic_back"
                app:tint="@color/pdf_reader_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- A document name is the one thing on this bar the reader
                     cannot guess from context, so it gets a second line before
                     it is allowed to truncate. -->
                <TextView
                    android:id="@+id/pdf_reader_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/pdf_reader_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pdf_reader_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/pdf_reader_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/pdf_reader_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pdf_reader_search"
                android:scaleType="centerInside"
                android:src="@drawable/pdf_reader_ic_search"
                app:tint="@color/pdf_reader_text_primary" />

            <ImageButton
                android:id="@+id/pdf_reader_save"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pdf_reader_save"
                android:scaleType="centerInside"
                android:src="@drawable/pdf_reader_ic_save"
                app:tint="@color/pdf_reader_text_primary" />

            <ImageButton
                android:id="@+id/pdf_reader_share"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pdf_reader_share"
                android:scaleType="centerInside"
                android:src="@drawable/pdf_reader_ic_share"
                app:tint="@color/pdf_reader_text_primary" />

            <ImageButton
                android:id="@+id/pdf_reader_tools"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pdf_reader_tools"
                android:scaleType="centerInside"
                android:src="@drawable/pdf_reader_ic_tools"
                app:tint="@color/pdf_reader_accent" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/pdf_reader_hairline" />

        <FrameLayout
            android:id="@+id/pdf_reader_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pdf_reader_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pdf_reader_surface"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/pdf_reader_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/pdf_reader_loading"
            android:textColor="@color/pdf_reader_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pdf_reader_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pdf_reader_surface"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pdf_reader_error_title"
            android:textColor="@color/pdf_reader_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pdf_reader_error_body"
            android:textColor="@color/pdf_reader_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/pdf_reader_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/pdf_reader_button_primary"
            android:minHeight="48dp"
            android:text="@string/pdf_reader_retry"
            android:textAllCaps="false"
            android:textColor="@color/pdf_reader_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pdf_reader_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/pdf_reader_button_secondary"
            android:minHeight="48dp"
            android:text="@string/pdf_reader_close"
            android:textAllCaps="false"
            android:textColor="@color/pdf_reader_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/pdf_reader_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/pdf_reader_message_background"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/pdf_reader_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
