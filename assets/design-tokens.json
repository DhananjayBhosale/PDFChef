{
  "$schema": "https://design-tokens.org/draft",
  "meta": {
    "name": "PDF Chef",
    "version": "3.0.0",
    "owner": "Claude UI owner (PDF Chef iOS)",
    "source": "docs/brand-guidelines.md",
    "mirror": "assets/design-tokens.css",
    "note": "Values authored in OKLCH intent, shipped as sRGB hex for iOS 15 WebKit compatibility. Keep this file and assets/design-tokens.css byte-for-byte equivalent in value. Semantic text values clear WCAG AA 4.5:1 on canvas, raised and sunken in their own theme; border.strong clears 3:1 on all three because it bounds controls, border.hairline only separates."
  },
  "color": {
    "paper": {
      "description": "Warm neutral with a faint yellow-brown cast, like uncoated stock. The ground the product sits on. Canvas is 50, the raised card is 25, the sunken track is 100. Never #000.",
      "oklchHue": 80,
      "scale": {
        "25": "#ffffff",
        "50": "#faf7f2",
        "100": "#f2ede5",
        "200": "#e6dfd4",
        "300": "#d3c9ba",
        "400": "#a89c8c",
        "500": "#857a6b",
        "600": "#6f665c",
        "700": "#57504a",
        "800": "#34302a",
        "900": "#1d1a16",
        "950": "#14120f"
      }
    },
    "ink": {
      "description": "The single accent, one tomato red. Primary actions, current selection, slots. Never decoration. The ink name is retained for token compatibility.",
      "oklchHue": 32,
      "scale": {
        "25": "#fef6f3",
        "50": "#fbe9e3",
        "100": "#f6d3c8",
        "200": "#ffc2b2",
        "300": "#ff8a70",
        "400": "#c9402a",
        "500": "#c63c24",
        "600": "#c23a22",
        "700": "#a93119",
        "800": "#8a2814",
        "900": "#3a2018",
        "950": "#24120d"
      }
    },
    "success": {
      "description": "Completed, saved, reduced. Olive rather than signal green so it reads calm on paper.",
      "oklchHue": 145,
      "scale": {
        "50": "#ecf3ea",
        "100": "#d7e7d3",
        "200": "#b6d2b0",
        "300": "#96be8e",
        "400": "#6d9a63",
        "500": "#4e7a46",
        "600": "#3f6538",
        "700": "#34512e",
        "800": "#2a3f26",
        "900": "#20301e",
        "950": "#141d13"
      }
    },
    "caution": {
      "description": "Beta surfaces, large-document memory warnings, review-first copy. Never the only signal.",
      "oklchHue": 75,
      "scale": {
        "50": "#fbf1e0",
        "100": "#f6e3c2",
        "200": "#eccd97",
        "300": "#e0b368",
        "400": "#c8933a",
        "500": "#a9761b",
        "600": "#8c6014",
        "700": "#704c11",
        "800": "#573b0f",
        "900": "#422d0d",
        "950": "#291c08"
      }
    },
    "danger": {
      "description": "Destructive and failed. Deletion, clear-all, processing errors.",
      "oklchHue": 22,
      "scale": {
        "50": "#fbecea",
        "100": "#f7d8d3",
        "200": "#eeb3a9",
        "300": "#e09285",
        "400": "#c4634f",
        "500": "#a6412f",
        "600": "#8c3526",
        "700": "#712b1f",
        "800": "#57221a",
        "900": "#421a14",
        "950": "#28100c"
      }
    }
  },
  "semantic": {
    "light": {
      "surface.canvas": "#faf7f2",
      "surface.raised": "#ffffff",
      "surface.sunken": "#f2ede5",
      "surface.chrome": "rgba(250, 247, 242, 0.94)",
      "surface.scrim": "rgba(29, 26, 22, 0.42)",
      "border.hairline": "#e6dfd4",
      "border.strong": "#857a6b",
      "text.primary": "#1d1a16",
      "text.body": "#34302a",
      "text.secondary": "#57504a",
      "text.tertiary": "#6f665c",
      "text.onAccent": "#ffffff",
      "accent.rest": "#c23a22",
      "accent.hover": "#a5301b",
      "accent.quiet": "#fbe9e3",
      "accent.onQuiet": "#8a2814",
      "accent.text": "#a93119",
      "focus.ring": "#1d1a16",
      "status.success.text": "#2f6a35",
      "status.success.quiet": "#e9f1e4",
      "status.caution.text": "#845600",
      "status.caution.quiet": "#f8eed6",
      "status.danger.text": "#a3301c",
      "status.danger.quiet": "#fae6df",
      "chef.tabRest": "#6f665c"
    },
    "dark": {
      "surface.canvas": "#14120f",
      "surface.raised": "#1c1915",
      "surface.sunken": "#24201b",
      "surface.chrome": "rgba(20, 18, 15, 0.94)",
      "surface.scrim": "rgba(0, 0, 0, 0.6)",
      "border.hairline": "#332d25",
      "border.strong": "#857a6a",
      "text.primary": "#f4eee4",
      "text.body": "#e2dacd",
      "text.secondary": "#bfb4a5",
      "text.tertiary": "#9e9385",
      "text.onAccent": "#ffffff",
      "accent.rest": "#c9402a",
      "accent.hover": "#b5361f",
      "accent.quiet": "#3a2018",
      "accent.onQuiet": "#ffc2b2",
      "accent.text": "#ff8a70",
      "focus.ring": "#f4eee4",
      "status.success.text": "#93cf8e",
      "status.success.quiet": "rgba(147, 207, 142, 0.14)",
      "status.caution.text": "#e7bb65",
      "status.caution.quiet": "rgba(231, 187, 101, 0.14)",
      "status.danger.text": "#ff9f88",
      "status.danger.quiet": "rgba(255, 159, 136, 0.14)",
      "chef.tabRest": "#9e9385"
    }
  },
  "typography": {
    "family": {
      "ui": "\"Inter Variable\", \"Inter\", -apple-system, BlinkMacSystemFont, \"SF Pro Text\", system-ui, \"Segoe UI\", \"Noto Sans Arabic\", \"Geeza Pro\", \"Noto Sans Devanagari\", \"Kohinoor Devanagari\", \"Nirmala UI\", sans-serif",
      "system": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", system-ui, \"Segoe UI\", Roboto, sans-serif",
      "numeric": "\"Inter Variable\", -apple-system, system-ui, sans-serif",
      "display": "\"Iowan Old Style\", Charter, \"Noto Serif\", Georgia, serif",
      "displayWeight": 600
    },
    "scale": {
      "caption": { "size": "0.75rem", "leading": "1.3333", "tracking": "0.01em", "weight": 600 },
      "footnote": { "size": "0.75rem", "leading": "1.3333", "tracking": "0.005em", "weight": 500 },
      "body": { "size": "0.875rem", "leading": "1.4286", "tracking": "0em", "weight": 450 },
      "callout": { "size": "1rem", "leading": "1.375", "tracking": "-0.002em", "weight": 500 },
      "title3": { "size": "1.25rem", "leading": "1.3", "tracking": "-0.008em", "weight": 600 },
      "title2": { "size": "1.5rem", "leading": "1.25", "tracking": "-0.014em", "weight": 600 },
      "title1": { "size": "1.875rem", "leading": "1.2", "tracking": "-0.02em", "weight": 650 },
      "display": { "size": "1.875rem", "leading": "1.2", "tracking": "-0.024em", "weight": 700 }
    },
    "note": "The Android app is the size authority: Meta 12/16, Body 14/20, Emphasis 16/22, Title 20/26, Heading 24/30, Display 30/36. Caption and footnote share the Meta step and differ by weight and case. Tracking is size-specific: negative as type grows, near zero at body, slightly positive at caption. Sizes are rem so the readable-text-size preference and OS text scaling move layout with the text."
  },
  "space": {
    "unit": "0.25rem",
    "scale": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem"
    }
  },
  "radius": {
    "control": "999px",
    "field": "10px",
    "row": "1rem",
    "panel": "10px",
    "sheet": "18px",
    "pill": "999px",
    "slot": "6px",
    "pop": "10px"
  },
  "size": {
    "touchTarget": "48px",
    "tabBar": "60px",
    "navBar": "44px",
    "readingMeasure": "68ch"
  },
  "elevation": {
    "flat": "none",
    "raised": "none",
    "chip": "0 1px 2px rgba(60, 40, 20, 0.14)",
    "panel": "0 0 0 1px #e6dfd4, 0 12px 30px -12px rgba(60, 40, 20, 0.22)",
    "sheet": "0 0 0 1px #e2dacd, 0 22px 50px -16px rgba(60, 40, 20, 0.34)",
    "dark": {
      "chip": "0 1px 2px rgba(0, 0, 0, 0.5)",
      "panel": "0 0 0 1px #332d25, 0 12px 30px -12px rgba(0, 0, 0, 0.6)",
      "sheet": "0 0 0 1px #3a332a, 0 22px 50px -16px rgba(0, 0, 0, 0.7)"
    }
  },
  "motion": {
    "note": "Critically damped by default. Overshoot only follows a user gesture that carried momentum.",
    "duration": {
      "instant": "80ms",
      "tap": "120ms",
      "transition": "220ms",
      "sheet": "320ms"
    },
    "easing": {
      "settle": "cubic-bezier(0.22, 1, 0.36, 1)",
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.55, 0, 0.45, 1)"
    },
    "spring": {
      "default": { "damping": 1.0, "response": 0.35 },
      "gesture": { "damping": 0.82, "response": 0.32 }
    }
  },
  "textScale": {
    "note": "Readable text size preference. Multiplies the root font size; every dimension in rem follows.",
    "small": 0.92,
    "default": 1,
    "large": 1.14,
    "larger": 1.3
  }
}
